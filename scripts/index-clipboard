#!/usr/bin/env bash
# WILL OF THE CITY :: THE INDEX — clipboard history backend
set -Eeuo pipefail

MAX_ITEMS=50
MAX_BYTES=$((100 * 1024 * 1024))
THUMB_SIZE=192
CACHE_ROOT="${XDG_CACHE_HOME:-$HOME/.cache}/the-index/clipboard"
PREVIEW_DIR="$CACHE_ROOT/previews"
LOCK_FILE="$CACHE_ROOT/store.lock"

mkdir -p "$PREVIEW_DIR"
chmod 700 "$CACHE_ROOT" "$PREVIEW_DIR" 2>/dev/null || true

have_backend() {
  command -v cliphist >/dev/null 2>&1 && command -v wl-copy >/dev/null 2>&1
}

valid_id() {
  [[ "$1" =~ ^[0-9]+$ ]]
}

sanitize_field() {
  local value="$1"
  value=${value//$'\t'/ }
  value=${value//$'\r'/ }
  value=${value//$'\n'/ }
  printf '%s' "$value"
}

prune_cache() {
  local ids_file file id
  ids_file="$(mktemp "${TMPDIR:-/tmp}/index-clipboard-ids.XXXXXX")"
  trap 'rm -f "$ids_file"' RETURN
  cliphist list 2>/dev/null | head -n "$MAX_ITEMS" | cut -f1 > "$ids_file" || true
  shopt -s nullglob
  for file in "$PREVIEW_DIR"/*.png; do
    id="$(basename "$file" .png)"
    grep -Fxq "$id" "$ids_file" || rm -f -- "$file"
  done
  shopt -u nullglob
  rm -f "$ids_file"
  trap - RETURN
}

prune_history() {
  local -a rows=()
  local i
  mapfile -t rows < <(cliphist list 2>/dev/null || true)
  if ((${#rows[@]} > MAX_ITEMS)); then
    for ((i=MAX_ITEMS; i<${#rows[@]}; i++)); do
      [[ -n "${rows[i]}" ]] || continue
      printf '%s\n' "${rows[i]}" | cliphist delete >/dev/null 2>&1 || true
    done
  fi
  prune_cache
}

generate_thumbnail() {
  local id="$1" source="$2" tmp_thumb
  valid_id "$id" || return 0
  command -v ffmpeg >/dev/null 2>&1 || return 0
  tmp_thumb="$(mktemp "$PREVIEW_DIR/.${id}.XXXXXX.png")"
  if ffmpeg -hide_banner -loglevel error -nostdin -y -i "$source" \
      -vf "scale=${THUMB_SIZE}:${THUMB_SIZE}:force_original_aspect_ratio=decrease" \
      -frames:v 1 "$tmp_thumb" >/dev/null 2>&1; then
    chmod 600 "$tmp_thumb" 2>/dev/null || true
    mv -f -- "$tmp_thumb" "$PREVIEW_DIR/$id.png"
  else
    rm -f -- "$tmp_thumb"
  fi
}

stored_item_matches() {
  local id="$1" source="$2"
  valid_id "$id" || return 1
  printf '%s\n' "$id" | cliphist decode 2>/dev/null | cmp -s - "$source"
}

store_unlocked() {
  local kind="${1:-data}" tmp_base tmp size id
  have_backend || return 0

  tmp_base="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}"
  [[ -d "$tmp_base" && -w "$tmp_base" ]] || tmp_base="${TMPDIR:-/tmp}"
  tmp="$(mktemp "$tmp_base/index-clipboard.XXXXXX")"
  chmod 600 "$tmp" 2>/dev/null || true
  trap 'rm -f -- "$tmp"' EXIT HUP INT TERM

  # Read at most one byte past the limit so oversized clipboard payloads are
  # rejected before they ever enter cliphist's persistent database.
  head -c "$((MAX_BYTES + 1))" > "$tmp" || true
  size="$(wc -c < "$tmp")"
  size="${size//[[:space:]]/}"
  if ! [[ "$size" =~ ^[0-9]+$ ]] || (( size == 0 || size > MAX_BYTES )); then
    rm -f -- "$tmp"
    trap - EXIT HUP INT TERM
    return 0
  fi

  # cliphist 0.4+ understands MAX_ITEMS through the environment. Newer
  # versions also understand MAX_STORE_SIZE; the explicit pre-read above keeps
  # the 100 MiB ceiling effective on older distro packages too.
  if ! CLIPHIST_MAX_ITEMS="$MAX_ITEMS" CLIPHIST_MAX_STORE_SIZE="100MiB" \
      cliphist store < "$tmp" >/dev/null; then
    rm -f -- "$tmp"
    trap - EXIT HUP INT TERM
    return 0
  fi

  id="$(cliphist list 2>/dev/null | head -n1 | cut -f1)"
  if [[ "$kind" == image ]] && valid_id "$id" && stored_item_matches "$id" "$tmp"; then
    generate_thumbnail "$id" "$tmp"
  fi
  prune_history

  rm -f -- "$tmp"
  trap - EXIT HUP INT TERM
}

store_item() {
  mkdir -p "$CACHE_ROOT"
  if command -v flock >/dev/null 2>&1; then
    (
      flock -x 9
      store_unlocked "${1:-data}"
    ) 9>"$LOCK_FILE"
  else
    store_unlocked "${1:-data}"
  fi
}

emit_rows() {
  local -a rows=()
  local row id mime preview kind thumb count=0

  if cliphist list -fields id,mime,preview >/dev/null 2>&1; then
    mapfile -t rows < <(cliphist list -fields id,mime,preview 2>/dev/null | head -n "$MAX_ITEMS")
    printf '@status\t1\t%d\n' "${#rows[@]}"
    for row in "${rows[@]}"; do
      IFS=$'\t' read -r id mime preview <<< "$row"
      valid_id "$id" || continue
      [[ -n "$preview" ]] || preview="(empty item)"
      kind=text
      [[ "$mime" == image/* ]] && kind=image
      thumb=""
      [[ -f "$PREVIEW_DIR/$id.png" ]] && { kind=image; thumb="file://$PREVIEW_DIR/$id.png"; }
      printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$kind" "$(sanitize_field "$mime")" "$(sanitize_field "$preview")" "$thumb"
      ((++count))
      (( count >= MAX_ITEMS )) && break
    done
  else
    mapfile -t rows < <(cliphist list 2>/dev/null | head -n "$MAX_ITEMS")
    printf '@status\t1\t%d\n' "${#rows[@]}"
    for row in "${rows[@]}"; do
      id="${row%%$'\t'*}"
      preview="${row#*$'\t'}"
      valid_id "$id" || continue
      [[ -n "$preview" ]] || preview="(empty item)"
      kind=text
      mime=""
      thumb=""
      if [[ -f "$PREVIEW_DIR/$id.png" ]]; then
        kind=image
        mime="image"
        thumb="file://$PREVIEW_DIR/$id.png"
      elif [[ "$preview" == *"binary data"* ]]; then
        kind=image
        mime="image"
      fi
      printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$kind" "$mime" "$(sanitize_field "$preview")" "$thumb"
      ((++count))
      (( count >= MAX_ITEMS )) && break
    done
  fi
}

dump_history() {
  if ! have_backend; then
    printf '@status\t0\t0\n'
    return 0
  fi
  emit_rows
}

select_item() {
  local id="${1:-}"
  have_backend || { echo "clipboard backend unavailable" >&2; exit 1; }
  valid_id "$id" || { echo "invalid clipboard id" >&2; exit 2; }
  printf '%s\n' "$id" | cliphist decode | wl-copy
}

clear_history() {
  have_backend || return 0
  cliphist wipe >/dev/null
  rm -f -- "$PREVIEW_DIR"/*.png 2>/dev/null || true
}

case "${1:-}" in
  store)
    [[ $# -le 2 ]] || exit 2
    case "${2:-data}" in text|image|data) ;; *) exit 2 ;; esac
    store_item "${2:-data}"
    ;;
  dump)
    [[ $# -eq 1 ]] || exit 2
    dump_history
    ;;
  select)
    [[ $# -eq 2 ]] || exit 2
    select_item "$2"
    ;;
  clear)
    [[ $# -eq 1 ]] || exit 2
    clear_history
    ;;
  prune)
    [[ $# -eq 1 ]] || exit 2
    have_backend && prune_history
    ;;
  *)
    echo "usage: index-clipboard {store [text|image]|dump|select ID|clear|prune}" >&2
    exit 2
    ;;
esac
