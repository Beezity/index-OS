#!/bin/sh
# WILL OF THE CITY :: THE INDEX — labwc input settings helper
set -eu

RC="${INDEX_INPUT_RC:-${XDG_CONFIG_HOME:-$HOME/.config}/labwc/rc.xml}"
LOCK="${RC}.input.lock"

sanitize() { printf '%s' "$1" | tr '\t\r\n' '   '; }

need_backend() {
  [ -f "$RC" ] || { echo "input backend unavailable: $RC" >&2; exit 1; }
}

first_tag() {
  tag=$1
  sed -n "s|.*<${tag}>\([^<]*\)</${tag}>.*|\1|p" "$RC" 2>/dev/null | head -n1
}

touchpad_present() {
  for f in /sys/class/input/event*/device/name /sys/class/input/input*/name; do
    [ -r "$f" ] || continue
    name=$(cat "$f" 2>/dev/null || true)
    printf '%s\n' "$name" | grep -Eqi 'touchpad|trackpad' && { printf '1'; return; }
  done
  grep -Eqi 'touchpad|trackpad' /proc/bus/input/devices 2>/dev/null && printf '1' || printf '0'
}

reload_labwc() {
  [ "${INDEX_INPUT_NO_RELOAD:-0}" = 1 ] && return 0
  command -v labwc >/dev/null 2>&1 || return 0
  labwc --reconfigure >/dev/null 2>&1 || true
}

replace_tag_all_unlocked() {
  tag=$1 value=$2
  grep -q "<${tag}>[^<]*</${tag}>" "$RC" || {
    echo "input setting missing from Labwc config: $tag" >&2
    return 1
  }
  dir=$(dirname "$RC")
  tmp=$(mktemp "$dir/.rc.xml.input.XXXXXX")
  trap 'rm -f "$tmp"' EXIT HUP INT TERM
  sed "s|<${tag}>[^<]*</${tag}>|<${tag}>${value}</${tag}>|g" "$RC" > "$tmp"
  if cmp -s "$RC" "$tmp"; then
    rm -f "$tmp"
    trap - EXIT HUP INT TERM
    return 0
  fi
  chmod --reference="$RC" "$tmp" 2>/dev/null || true
  mv "$tmp" "$RC"
  trap - EXIT HUP INT TERM
}

replace_tag_all() {
  need_backend
  tag=$1 value=$2
  if command -v flock >/dev/null 2>&1; then
    ( flock -x 9; replace_tag_all_unlocked "$tag" "$value" ) 9>"$LOCK"
  else
    replace_tag_all_unlocked "$tag" "$value"
  fi
  reload_labwc
}

state() {
  if [ ! -f "$RC" ]; then
    printf '0\t0.00\tno\t0\tyes\n'
    return 0
  fi
  speed=$(first_tag pointerSpeed || true)
  natural=$(first_tag naturalScroll || true)
  tap=$(first_tag tap || true)
  valid=1
  case "$speed" in
    -1|-1.0|-1.00|0|0.0|0.00|1|1.0|1.00|-0.[0-9]|-0.[0-9][0-9]|0.[0-9]|0.[0-9][0-9]) ;;
    *) speed=0.00; valid=0 ;;
  esac
  case "$natural" in yes|no) ;; *) natural=no; valid=0 ;; esac
  case "$tap" in yes|no) ;; *) tap=yes; valid=0 ;; esac
  printf '%s\t%s\t%s\t%s\t%s\n' "$valid" "$(sanitize "$speed")" "$natural" "$(touchpad_present)" "$tap"
}

case "${1:-}" in
  state)
    [ "$#" -eq 1 ] || exit 2
    state
    ;;
  set-speed)
    [ "$#" -eq 2 ] || exit 2
    case "$2" in
      -1|-1.0|-1.00|0|0.0|0.00|1|1.0|1.00|-0.[0-9]|-0.[0-9][0-9]|0.[0-9]|0.[0-9][0-9]) ;;
      *) echo "invalid pointer speed: $2" >&2; exit 2 ;;
    esac
    replace_tag_all pointerSpeed "$2"
    ;;
  set-natural-scroll)
    [ "$#" -eq 2 ] || exit 2
    case "$2" in yes|no) ;; *) echo "invalid natural-scroll value: $2" >&2; exit 2 ;; esac
    replace_tag_all naturalScroll "$2"
    ;;
  set-tap)
    [ "$#" -eq 2 ] || exit 2
    case "$2" in yes|no) ;; *) echo "invalid tap value: $2" >&2; exit 2 ;; esac
    replace_tag_all tap "$2"
    ;;
  *)
    echo "usage: index-input {state|set-speed VALUE|set-natural-scroll yes|no|set-tap yes|no}" >&2
    exit 2
    ;;
esac
