#!/bin/sh
# WILL OF THE CITY :: THE INDEX — compositor-aware input settings helper
set -eu

XDG_CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
LABWC_RC="${INDEX_INPUT_RC:-$XDG_CFG/labwc/rc.xml}"
NIRI_INPUT="${INDEX_INPUT_NIRI:-$XDG_CFG/niri/input.kdl}"

sanitize() { printf '%s' "$1" | tr '\t\r\n' '   '; }
valid_speed() { printf '%s\n' "$1" | grep -Eq '^-?(0([.][0-9]+)?|1([.]0+)?)$'; }

touchpad_present() {
  for f in /sys/class/input/event*/device/name /sys/class/input/input*/name; do
    [ -r "$f" ] || continue
    name=$(cat "$f" 2>/dev/null || true)
    printf '%s\n' "$name" | grep -Eqi 'touchpad|trackpad' && { printf '1'; return; }
  done
  grep -Eqi 'touchpad|trackpad' /proc/bus/input/devices 2>/dev/null && printf '1' || printf '0'
}

backend() {
  case "${INDEX_INPUT_BACKEND:-}" in niri|labwc) printf '%s' "$INDEX_INPUT_BACKEND"; return ;; esac
  # INDEX_INPUT_RC is used by the labwc unit tests and is an explicit backend selector.
  [ -n "${INDEX_INPUT_RC:-}" ] && { printf 'labwc'; return; }
  [ -n "${NIRI_SOCKET:-}" ] && { printf 'niri'; return; }
  case ":${XDG_CURRENT_DESKTOP:-}:${XDG_SESSION_DESKTOP:-}:" in
    *:niri:*|*:Niri:*) printf 'niri' ;;
    *) printf 'labwc' ;;
  esac
}

# ------------------------------ labwc ---------------------------------
labwc_managed_value() {
  tag=$1 scope=$2
  awk -v tag="$tag" -v scope="$scope" '
    /<device[^>]*category="default"[^>]*>/ { managed=(scope == "pointer") }
    /<device[^>]*category="touchpad"[^>]*>/ { managed=1 }
    managed {
      openTag="<" tag ">"; closeTag="</" tag ">"
      if (index($0, openTag)) {
        line=$0
        sub(".*" openTag, "", line)
        sub(closeTag ".*", "", line)
        print line
        exit
      }
    }
    /<\/device>/ { managed=0 }
  ' "$LABWC_RC" 2>/dev/null | head -n1
}

reload_labwc() {
  [ "${INDEX_INPUT_NO_RELOAD:-0}" = 1 ] && return 0
  command -v labwc >/dev/null 2>&1 || return 0
  labwc --reconfigure >/dev/null 2>&1 || true
}

labwc_replace_unlocked() {
  tag=$1 value=$2 scope=$3
  dir=$(dirname "$LABWC_RC")
  tmp=$(mktemp "$dir/.rc.xml.input.XXXXXX")
  trap 'rm -f "$tmp"' EXIT HUP INT TERM
  awk -v tag="$tag" -v value="$value" -v scope="$scope" '
    BEGIN { found=0; managed=0 }
    /<device[^>]*category="default"[^>]*>/ { managed=(scope == "pointer") }
    /<device[^>]*category="touchpad"[^>]*>/ { managed=1 }
    managed {
      openTag="<" tag ">"; closeTag="</" tag ">"
      if (index($0, openTag)) {
        found++
        pattern=openTag "[^<]*" closeTag
        replacement=openTag value closeTag
        gsub(pattern, replacement)
      }
    }
    { print }
    /<\/device>/ { managed=0 }
    END { if (found == 0) exit 3 }
  ' "$LABWC_RC" > "$tmp" || {
    status=$?
    rm -f "$tmp"
    trap - EXIT HUP INT TERM
    [ "$status" -eq 3 ] && echo "input setting missing from managed Labwc device categories: $tag" >&2
    return "$status"
  }
  if cmp -s "$LABWC_RC" "$tmp"; then rm -f "$tmp"; trap - EXIT HUP INT TERM; return 0; fi
  chmod --reference="$LABWC_RC" "$tmp" 2>/dev/null || true
  mv "$tmp" "$LABWC_RC"
  trap - EXIT HUP INT TERM
}

labwc_replace() {
  [ -f "$LABWC_RC" ] || { echo "input backend unavailable: $LABWC_RC" >&2; exit 1; }
  tag=$1 value=$2 scope=$3
  lock="$LABWC_RC.input.lock"
  if command -v flock >/dev/null 2>&1; then
    ( flock -x 9; labwc_replace_unlocked "$tag" "$value" "$scope" ) 9>"$lock"
  else
    labwc_replace_unlocked "$tag" "$value" "$scope"
  fi
  reload_labwc
}

labwc_state() {
  if [ ! -f "$LABWC_RC" ]; then printf '0\t0.00\tno\t%s\tyes\n' "$(touchpad_present)"; return; fi
  speed=$(labwc_managed_value pointerSpeed pointer || true)
  natural=$(labwc_managed_value naturalScroll pointer || true)
  tap=$(labwc_managed_value tap touchpad || true)
  touchpad=$(touchpad_present)
  valid=1
  if ! valid_speed "$speed"; then speed=0.00; valid=0; fi
  case "$natural" in yes|no) ;; *) natural=no; valid=0 ;; esac
  case "$tap" in yes|no) ;; *) tap=yes; [ "$touchpad" = 1 ] && valid=0 ;; esac
  printf '%s\t%s\t%s\t%s\t%s\n' "$valid" "$(sanitize "$speed")" "$natural" "$touchpad" "$tap"
}

# ------------------------------- niri ----------------------------------
niri_values() {
  speed=$(sed -n 's/^[[:space:]]*accel-speed[[:space:]]\+\(-\{0,1\}[0-9][0-9.]*\).*$/\1/p' "$NIRI_INPUT" 2>/dev/null | head -n1 || true)
  [ -n "$speed" ] || speed=0.0
  if grep -Eq '^[[:space:]]*natural-scroll([[:space:]]|$)' "$NIRI_INPUT" 2>/dev/null; then natural=yes; else natural=no; fi
  if awk '/touchpad[[:space:]]*\{/{inside=1;next} inside && /^[[:space:]]*\}/{exit} inside && /^[[:space:]]*tap([[:space:]]|$)/{found=1} END{exit !found}' "$NIRI_INPUT" 2>/dev/null; then tap=yes; else tap=no; fi
  printf '%s\t%s\t%s\n' "$speed" "$natural" "$tap"
}

niri_validate() {
  [ "${INDEX_INPUT_NO_VALIDATE:-0}" = 1 ] && return 0
  command -v niri >/dev/null 2>&1 || return 0
  NIRI_CONFIG="${INDEX_NIRI_CONFIG:-$XDG_CFG/niri/config.kdl}" niri validate >/dev/null
}

niri_write() {
  speed=$1 natural=$2 tap=$3
  valid_speed "$speed" || { echo "invalid pointer speed: $speed" >&2; exit 2; }
  case "$natural" in yes|no) ;; *) echo "invalid natural-scroll value: $natural" >&2; exit 2 ;; esac
  case "$tap" in yes|no) ;; *) echo "invalid tap value: $tap" >&2; exit 2 ;; esac
  dir=$(dirname "$NIRI_INPUT")
  mkdir -p "$dir"
  old=""
  if [ -f "$NIRI_INPUT" ]; then old=$(mktemp "$dir/.input.old.XXXXXX"); cp -f "$NIRI_INPUT" "$old"; fi
  tmp=$(mktemp "$dir/.input.XXXXXX")
  {
    echo '// WILL OF THE CITY :: THE INDEX — managed input settings'
    echo 'input {'
    echo '    keyboard {'
    echo '        repeat-rate 30'
    echo '        repeat-delay 400'
    echo '        track-layout "global"'
    echo '    }'
    echo
    echo '    mouse {'
    printf '        accel-speed %s\n' "$speed"
    echo '        accel-profile "adaptive"'
    [ "$natural" = yes ] && echo '        natural-scroll'
    echo '    }'
    echo
    echo '    touchpad {'
    [ "$tap" = yes ] && echo '        tap'
    echo '        dwt'
    echo '        drag true'
    printf '        accel-speed %s\n' "$speed"
    echo '        accel-profile "adaptive"'
    [ "$natural" = yes ] && echo '        natural-scroll'
    echo '        scroll-factor 1.0'
    echo '    }'
    echo '}'
  } > "$tmp"
  mv "$tmp" "$NIRI_INPUT"
  if ! niri_validate; then
    if [ -n "$old" ]; then mv "$old" "$NIRI_INPUT"; else rm -f "$NIRI_INPUT"; fi
    echo 'niri rejected the input configuration; previous settings restored' >&2
    exit 1
  fi
  [ -z "$old" ] || rm -f "$old"
}

niri_state() {
  touchpad=$(touchpad_present)
  if [ ! -f "$NIRI_INPUT" ]; then printf '0\t0.00\tno\t%s\tyes\n' "$touchpad"; return; fi
  vals=$(niri_values)
  speed=$(printf '%s' "$vals" | cut -f1)
  natural=$(printf '%s' "$vals" | cut -f2)
  tap=$(printf '%s' "$vals" | cut -f3)
  valid=1
  valid_speed "$speed" || { speed=0.00; valid=0; }
  case "$natural" in yes|no) ;; *) natural=no; valid=0 ;; esac
  case "$tap" in yes|no) ;; *) tap=yes; [ "$touchpad" = 1 ] && valid=0 ;; esac
  printf '%s\t%s\t%s\t%s\t%s\n' "$valid" "$(sanitize "$speed")" "$natural" "$touchpad" "$tap"
}

B=$(backend)
case "${1:-}" in
  state)
    [ "$#" -eq 1 ] || exit 2
    [ "$B" = niri ] && niri_state || labwc_state
    ;;
  set-speed)
    [ "$#" -eq 2 ] || exit 2
    valid_speed "$2" || { echo "invalid pointer speed: $2" >&2; exit 2; }
    if [ "$B" = niri ]; then vals=$(niri_values); niri_write "$2" "$(printf '%s' "$vals" | cut -f2)" "$(printf '%s' "$vals" | cut -f3)"; else labwc_replace pointerSpeed "$2" pointer; fi
    ;;
  set-natural-scroll)
    [ "$#" -eq 2 ] || exit 2
    case "$2" in yes|no) ;; *) echo "invalid natural-scroll value: $2" >&2; exit 2 ;; esac
    if [ "$B" = niri ]; then vals=$(niri_values); niri_write "$(printf '%s' "$vals" | cut -f1)" "$2" "$(printf '%s' "$vals" | cut -f3)"; else labwc_replace naturalScroll "$2" pointer; fi
    ;;
  set-tap)
    [ "$#" -eq 2 ] || exit 2
    case "$2" in yes|no) ;; *) echo "invalid tap value: $2" >&2; exit 2 ;; esac
    if [ "$B" = niri ]; then vals=$(niri_values); niri_write "$(printf '%s' "$vals" | cut -f1)" "$(printf '%s' "$vals" | cut -f2)" "$2"; else labwc_replace tap "$2" touchpad; fi
    ;;
  *) echo "usage: index-input {state|set-speed VALUE|set-natural-scroll yes|no|set-tap yes|no}" >&2; exit 2 ;;
esac
