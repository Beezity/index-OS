#!/bin/sh
# WILL OF THE CITY :: THE INDEX — persist the live output layout
set -eu

CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_DIR="$CFG/the-index"
STATE="$STATE_DIR/display.json"
NIRI_OUTPUTS="$CFG/niri/index-outputs.kdl"
LEGACY_STATE="$CFG/labwc/display.json"
mkdir -p "$STATE_DIR"

command -v wlr-randr >/dev/null 2>&1 || { echo "wlr-randr is required" >&2; exit 1; }
command -v python3 >/dev/null 2>&1 || { echo "python3 is required" >&2; exit 1; }

backend() {
  case "${INDEX_COMPOSITOR:-}" in niri|labwc) printf '%s' "$INDEX_COMPOSITOR"; return ;; esac
  if [ -n "${NIRI_SOCKET:-}" ]; then printf niri; return; fi
  case ":${XDG_CURRENT_DESKTOP:-}:${XDG_SESSION_DESKTOP:-}:" in
    *:niri:*) printf niri; return ;;
    *:labwc:*) printf labwc; return ;;
  esac
  [ -f "$CFG/niri/config.kdl" ] && [ ! -f "$CFG/labwc/rc.xml" ] && { printf niri; return; }
  printf labwc
}

TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT HUP INT TERM
wlr-randr > "$TMP"

python3 - "$TMP" "$STATE" "$(backend)" "$NIRI_OUTPUTS" "$LEGACY_STATE" <<'PY'
import json
import os
import re
import shutil
import sys

source, destination, backend, niri_destination, legacy_destination = sys.argv[1:6]
outputs = []
current = None
reading_modes = False

header_re = re.compile(r'^(\S+)\s+"(.*)"$')
mode_re = re.compile(r'^(\d+)x(\d+)\s+px(?:,\s*([0-9.]+)\s+Hz)?(?:\s+\(([^)]*)\))?$')

with open(source, encoding="utf-8", errors="replace") as handle:
    for raw in handle:
        line = raw.rstrip("\n")
        if line and not line[0].isspace():
            match = header_re.match(line)
            if not match:
                # A few wlr-randr builds omit the human-readable quoted name.
                match = re.match(r'^(\S+)(?:\s+(.*))?$', line)
            if match:
                current = {
                    "name": match.group(1),
                    "description": (match.group(2) or match.group(1)).strip('"'),
                    "enabled": False,
                    "modes": [],
                    "position": {"x": 0, "y": 0},
                    "transform": "normal",
                    "scale": 1.0,
                }
                outputs.append(current)
                reading_modes = False
            continue

        if current is None:
            continue
        text = line.strip()
        if text.startswith("Enabled:"):
            current["enabled"] = text.split(":", 1)[1].strip() == "yes"
            reading_modes = False
        elif text == "Modes:":
            reading_modes = True
        elif reading_modes:
            match = mode_re.match(text)
            if match:
                flags = match.group(4) or ""
                current["modes"].append({
                    "width": int(match.group(1)),
                    "height": int(match.group(2)),
                    "refresh": float(match.group(3) or 0),
                    "preferred": "preferred" in flags,
                    "current": "current" in flags,
                })
                continue
            reading_modes = False

        if text.startswith("Position:"):
            value = text.split(":", 1)[1].strip().split(",", 1)
            if len(value) == 2:
                try:
                    current["position"] = {"x": int(value[0]), "y": int(value[1])}
                except ValueError:
                    pass
        elif text.startswith("Transform:"):
            current["transform"] = text.split(":", 1)[1].strip() or "normal"
        elif text.startswith("Scale:"):
            try:
                current["scale"] = float(text.split(":", 1)[1].strip())
            except ValueError:
                pass

if not outputs:
    raise SystemExit("no outputs returned by wlr-randr")

os.makedirs(os.path.dirname(destination), exist_ok=True)
tmp = destination + ".tmp"
with open(tmp, "w", encoding="utf-8") as handle:
    json.dump(outputs, handle, indent=2)
    handle.write("\n")
os.chmod(tmp, 0o600)
os.replace(tmp, destination)

if backend == "niri":
    os.makedirs(os.path.dirname(niri_destination), exist_ok=True)
    kdl = niri_destination + ".tmp"
    valid_transforms = {
        "normal", "90", "180", "270",
        "flipped", "flipped-90", "flipped-180", "flipped-270",
    }
    with open(kdl, "w", encoding="utf-8") as handle:
        handle.write("// WILL OF THE CITY :: THE INDEX — managed output state\n")
        handle.write("// Generated by index-display-save from the live compositor layout.\n")
        handle.write("// Edit advanced niri output rules in config.kdl instead of this file.\n\n")
        for output in outputs:
            name = output.get("name")
            if not name:
                continue
            handle.write(f"output {json.dumps(name, ensure_ascii=False)} {{\n")
            if not output.get("enabled"):
                handle.write("    off\n")
                handle.write("}\n\n")
                continue

            modes = output.get("modes") or []
            mode = next((m for m in modes if m.get("current")), None)
            if mode is None:
                mode = next((m for m in modes if m.get("preferred")), None)
            if mode:
                value = f"{int(mode['width'])}x{int(mode['height'])}"
                refresh = float(mode.get("refresh") or 0)
                if refresh > 0:
                    value += f"@{refresh:.3f}"
                handle.write(f"    mode {json.dumps(value)}\n")

            try:
                scale = float(output.get("scale", 1.0))
            except (TypeError, ValueError):
                scale = 1.0
            if scale > 0:
                handle.write(f"    scale {scale:.4f}\n")

            transform = output.get("transform") or "normal"
            if transform in valid_transforms:
                handle.write(f"    transform {json.dumps(transform)}\n")

            position = output.get("position") or {}
            try:
                x = int(position.get("x", 0))
                y = int(position.get("y", 0))
                handle.write(f"    position x={x} y={y}\n")
                if x == 0 and y == 0:
                    handle.write("    focus-at-startup\n")
            except (TypeError, ValueError):
                pass
            handle.write("}\n\n")
    os.chmod(kdl, 0o600)
    os.replace(kdl, niri_destination)
else:
    # Keep the legacy location synchronized while Debian remains on labwc.
    os.makedirs(os.path.dirname(legacy_destination), exist_ok=True)
    legacy_tmp = legacy_destination + ".tmp"
    shutil.copyfile(destination, legacy_tmp)
    os.chmod(legacy_tmp, 0o600)
    os.replace(legacy_tmp, legacy_destination)
PY

printf '%s\n' "saved"
