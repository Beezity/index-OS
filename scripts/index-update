#!/usr/bin/env bash
set -Eeuo pipefail

REPO_URL="https://github.com/Beezity/index-OS.git"
BRANCH="main"
TMP=""

cleanup(){ [[ -z "$TMP" ]] || rm -rf "$TMP"; }
trap cleanup EXIT

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<'EOF'
usage: index-update

Downloads the latest THE INDEX main branch and reapplies the installer for the
current supported distribution. A normal pre-install backup is created first.
EOF
  exit 0
fi
(( $# == 0 )) || { echo "usage: index-update" >&2; exit 2; }

command -v git >/dev/null 2>&1 || { echo "index-update: git is required" >&2; exit 1; }

if [[ -r /etc/fedora-release ]] && command -v dnf >/dev/null 2>&1; then
  INSTALLER="install-fedora.sh"
  DISTRO="Fedora"
elif command -v pacman >/dev/null 2>&1 && [[ -r /etc/arch-release ]]; then
  INSTALLER="install.sh"
  DISTRO="Arch Linux"
else
  echo "index-update: unsupported distribution" >&2
  echo "Currently supported: Arch Linux and Fedora." >&2
  exit 1
fi

printf 'WILL OF THE CITY :: THE INDEX\n'
printf 'Updating THE INDEX on %s...\n' "$DISTRO"
TMP="$(mktemp -d)"
git clone --depth=1 --branch "$BRANCH" "$REPO_URL" "$TMP/index-OS"
cd "$TMP/index-OS"

[[ -f "$INSTALLER" ]] || { echo "index-update: downloaded repository is missing $INSTALLER" >&2; exit 1; }

printf 'Latest files downloaded. Running %s...\n\n' "$INSTALLER"
bash "./$INSTALLER"

printf '\nTHE INDEX update completed.\n'
printf 'Run index-doctor to verify the installation.\n'
