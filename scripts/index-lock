#!/bin/sh
# WILL OF THE CITY :: THE INDEX — compositor-neutral secure lock launcher
set -u
LOCK_QML="$HOME/.config/quickshell/lock/lock.qml"
pgrep -u "$(id -u)" -f '[q]uickshell.*lock/lock.qml' >/dev/null 2>&1 && exit 0
[ -n "${WAYLAND_DISPLAY:-}" ] || { echo 'index-lock: WAYLAND_DISPLAY is not set' >&2; exit 1; }
[ -f "$LOCK_QML" ] || { printf 'index-lock: missing %s\n' "$LOCK_QML" >&2; exit 1; }
QS="$(command -v quickshell 2>/dev/null || command -v qs 2>/dev/null || true)"
[ -n "$QS" ] || { echo 'index-lock: quickshell is not installed' >&2; exit 1; }
RUNTIME="${XDG_RUNTIME_DIR:-/tmp}"
MARKER="$RUNTIME/index-intro-shown"
if [ -e "$MARKER" ]; then export INDEX_INTRO=0; else export INDEX_INTRO=1; : > "$MARKER"; fi
if { [ -r /sys/class/dmi/id/sys_vendor ] && grep -qi 'vmware' /sys/class/dmi/id/sys_vendor; } || \
   { command -v systemd-detect-virt >/dev/null 2>&1 && [ "$(systemd-detect-virt 2>/dev/null || true)" = "vmware" ]; }; then
  export QT_QUICK_BACKEND=software
fi
exec "$QS" -p "$LOCK_QML"
