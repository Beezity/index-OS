#!/usr/bin/env bash
set -u
CYAN=$'\e[38;2;93;173;226m'; GREEN=$'\e[38;2;93;226;133m'; YELLOW=$'\e[38;2;255;210;92m'; RED=$'\e[38;2;255;107;107m'; DIM=$'\e[2m'; NC=$'\e[0m'
PASS=0; WARN=0; FAIL=0
ok(){ printf '  %s[OK]%s   %s\n' "$GREEN" "$NC" "$1"; ((PASS++)); }
warn(){ printf '  %s[WARN]%s %s\n' "$YELLOW" "$NC" "$1"; ((WARN++)); }
fail(){ printf '  %s[FAIL]%s %s\n' "$RED" "$NC" "$1"; ((FAIL++)); }
section(){ printf '\n%s%s%s\n' "$CYAN" "$1" "$NC"; }
has(){ command -v "$1" >/dev/null 2>&1; }
check_cmd(){ has "$1" && ok "$1 available" || fail "$1 missing"; }
check_file(){ [[ -e "$1" ]] && ok "$2" || fail "$2 missing ($1)"; }

CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
COMPOSITOR=labwc
[[ -f "$CFG/the-index/compositor" ]] && COMPOSITOR="$(cat "$CFG/the-index/compositor" 2>/dev/null || true)"
case "$COMPOSITOR" in labwc|niri) ;; *) COMPOSITOR=labwc ;; esac

printf '%sWILL OF THE CITY :: THE INDEX%s\n%sSYSTEM DIAGNOSTIC // %s%s\n' "$CYAN" "$NC" "$DIM" "$COMPOSITOR" "$NC"
section "SYSTEM"
if [[ -r /etc/os-release ]]; then . /etc/os-release; ok "${PRETTY_NAME:-${NAME:-Linux}}"; else warn "could not read /etc/os-release"; fi
ok "architecture: $(uname -m)"; printf '  %sINFO%s  kernel: %s\n' "$DIM" "$NC" "$(uname -r)"

section "CORE"
for cmd in quickshell foot fish fastfetch wofi; do check_cmd "$cmd"; done
if [[ "$COMPOSITOR" == niri ]]; then
  check_cmd niri; check_cmd niri-session; check_cmd xwayland-satellite; check_cmd gnome-keyring-daemon
else
  check_cmd labwc; check_cmd wlr-randr
fi

section "SESSION"
if [[ "$COMPOSITOR" == niri ]]; then
  check_file /usr/share/wayland-sessions/the-index-niri.desktop "THE INDEX (Niri) session registered"
  check_file "$CFG/niri/config.kdl" "Niri configuration"
  check_file "$CFG/niri/input.kdl" "Niri managed input"
  check_file "$CFG/niri/outputs.kdl" "Niri managed outputs"
  check_file "$CFG/niri/cursor.kdl" "Niri managed cursor"
  check_file "$CFG/niri/index-autostart" "Niri startup"
  check_file "$CFG/xdg-desktop-portal/niri-portals.conf" "Niri portal preferences"
  if [[ -f "$CFG/xdg-desktop-portal/niri-portals.conf" ]] && grep -q '^org.freedesktop.impl.portal.FileChooser=gtk;$' "$CFG/xdg-desktop-portal/niri-portals.conf"; then
    ok "GTK file chooser portal selected"
  else
    fail "Niri GTK file chooser portal override missing"
  fi
  if has niri && NIRI_CONFIG="$CFG/niri/config.kdl" niri validate >/dev/null 2>&1; then ok "Niri configuration validates"; else fail "Niri configuration validation failed"; fi
  [[ -n "${NIRI_SOCKET:-}" || "${XDG_CURRENT_DESKTOP:-}" == *niri* ]] && ok "Niri session detected" || warn "doctor is not running inside a Niri session"
else
  check_file /usr/share/wayland-sessions/the-index.desktop "THE INDEX labwc session registered"
  check_file "$CFG/labwc/rc.xml" "labwc configuration"
  check_file "$CFG/labwc/autostart" "labwc autostart"
  check_file "$CFG/labwc/index-display-save" "labwc display saver"
  check_file "$CFG/labwc/index-display-restore" "labwc display restorer"
  [[ "${XDG_CURRENT_DESKTOP:-}" == *labwc* || "${XDG_SESSION_DESKTOP:-}" == *labwc* ]] && ok "labwc session detected" || warn "doctor is not running inside a labwc session"
fi
if has systemctl; then
  if systemctl is-enabled --quiet gdm.service 2>/dev/null || systemctl is-enabled --quiet gdm3.service 2>/dev/null; then
    ok "GDM enabled"
  else
    warn "GDM is not enabled"
  fi
fi

section "INDEX SHELL"
for pair in \
  "$CFG/quickshell/shell.qml|Quickshell shell" \
  "$CFG/quickshell/Bar.qml|top bar" \
  "$CFG/quickshell/SettingsPanel.qml|Settings panel" \
  "$CFG/quickshell/DisplaysPanel.qml|Displays panel" \
  "$CFG/quickshell/InputPanel.qml|Input panel" \
  "$CFG/quickshell/PrescriptState.qml|shared Prescript state" \
  "$HOME/.local/bin/index-displays|display backend" \
  "$HOME/.local/bin/index-input|input backend" \
  "$HOME/.local/bin/index-power|power backend" \
  "$HOME/.local/bin/index-lock|lock helper" \
  "$HOME/.local/bin/index-idle|idle helper"; do
  check_file "${pair%%|*}" "${pair#*|}"
done
if [[ -f "$CFG/quickshell/shell.qml" ]] && grep -q 'model: Quickshell.screens' "$CFG/quickshell/shell.qml"; then ok "per-monitor shell surfaces enabled"; else fail "per-monitor shell surfaces missing"; fi
if [[ -x "$HOME/.local/bin/index-input" ]]; then INPUT_STATE="$("$HOME/.local/bin/index-input" state 2>/dev/null || true)"; [[ "${INPUT_STATE%%$'\t'*}" == 1 ]] && ok "$COMPOSITOR input backend readable" || fail "$COMPOSITOR input backend unavailable"; fi
if [[ -x "$HOME/.local/bin/index-displays" ]]; then DISPLAY_STATE="$("$HOME/.local/bin/index-displays" state 2>/dev/null | head -n1 || true)"; [[ "$DISPLAY_STATE" == $'@output\t'* ]] && ok "$COMPOSITOR display backend readable" || fail "$COMPOSITOR display backend unavailable"; fi

section "THEMING"
check_file "$HOME/.local/share/themes/the-index/gtk-3.0/gtk.css" "Index GTK3 theme"
check_file "$HOME/.local/share/themes/the-index/gtk-4.0/gtk.css" "Index GTK4 theme"
check_file "$CFG/gtk-3.0/settings.ini" "GTK3 settings"
check_file "$CFG/gtk-4.0/settings.ini" "GTK4 settings"
[[ -f /usr/share/icons/Papirus-Dark/index.theme ]] && ok "Papirus-Dark icon theme" || fail "Papirus-Dark icon theme missing"
[[ -d /usr/share/icons/Adwaita/cursors ]] && ok "Adwaita cursor theme" || fail "Adwaita cursor theme missing"
has fc-match && fc-match 'Perfect DOS VGA 437 Universal' 2>/dev/null | grep -qi 'PerfectDOS\|Perfect DOS' && ok "Perfect DOS VGA Universal font available" || warn "Universal DOS font could not be confirmed"

section "DESKTOP SERVICES"
for cmd in nmcli bluetoothctl wpctl wl-copy wl-paste cliphist qalc ffmpeg notify-send playerctl upower brightnessctl; do check_cmd "$cmd"; done
if has systemctl; then
  for svc in NetworkManager bluetooth cups; do systemctl is-enabled --quiet "$svc.service" 2>/dev/null && ok "$svc enabled" || warn "$svc not enabled"; done
  if systemctl is-active --quiet power-profiles-daemon.service 2>/dev/null || systemctl is-active --quiet tuned-ppd.service 2>/dev/null; then ok "power profile backend active"; else warn "power profile backend not active"; fi
fi
pgrep -x pipewire >/dev/null 2>&1 && ok "PipeWire running" || warn "PipeWire not detected"
pgrep -x wireplumber >/dev/null 2>&1 && ok "WirePlumber running" || warn "WirePlumber not detected"

section "RESULT"
printf '  %s%d passed%s / %s%d warnings%s / %s%d failed%s\n' "$GREEN" "$PASS" "$NC" "$YELLOW" "$WARN" "$NC" "$RED" "$FAIL" "$NC"
(( FAIL == 0 ))
