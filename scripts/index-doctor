#!/usr/bin/env bash
set -u

CYAN=$'\e[38;2;93;173;226m'; GREEN=$'\e[38;2;93;226;133m'; YELLOW=$'\e[38;2;255;210;92m'; RED=$'\e[38;2;255;107;107m'; DIM=$'\e[2m'; NC=$'\e[0m'
PASS=0; WARN=0; FAIL=0

ok(){ printf '  %s[OK]%s   %s\n' "$GREEN" "$NC" "$1"; ((PASS++)); }
warn(){ printf '  %s[WARN]%s %s\n' "$YELLOW" "$NC" "$1"; ((WARN++)); }
fail(){ printf '  %s[FAIL]%s %s\n' "$RED" "$NC" "$1"; ((FAIL++)); }
section(){ printf '\n%s%s%s\n' "$CYAN" "$1" "$NC"; }
has(){ command -v "$1" >/dev/null 2>&1; }
check_cmd(){ if has "$1"; then ok "$1 available"; else fail "$1 missing"; fi; }
check_file(){ if [[ -e "$1" ]]; then ok "$2"; else fail "$2 missing ($1)"; fi; }

COMPOSITOR=unknown
if [[ -n "${NIRI_SOCKET:-}" || "${XDG_CURRENT_DESKTOP:-}" == *niri* || "${XDG_SESSION_DESKTOP:-}" == *niri* ]]; then COMPOSITOR=niri
elif [[ "${XDG_CURRENT_DESKTOP:-}" == *labwc* || "${XDG_SESSION_DESKTOP:-}" == *labwc* ]]; then COMPOSITOR=labwc
elif [[ -f "$HOME/.config/niri/config.kdl" ]]; then COMPOSITOR=niri
elif [[ -f "$HOME/.config/labwc/rc.xml" ]]; then COMPOSITOR=labwc
fi

printf '%sWILL OF THE CITY :: THE INDEX%s\n' "$CYAN" "$NC"
printf '%sSYSTEM DIAGNOSTIC%s\n' "$DIM" "$NC"

section "SYSTEM"
if [[ -r /etc/os-release ]]; then
  . /etc/os-release
  ok "${PRETTY_NAME:-${NAME:-Linux}}"
else
  warn "could not read /etc/os-release"
fi
ok "architecture: $(uname -m)"
printf '  %sINFO%s  kernel: %s\n' "$DIM" "$NC" "$(uname -r)"
printf '  %sINFO%s  compositor backend: %s\n' "$DIM" "$NC" "$COMPOSITOR"

section "CORE"
if [[ "$COMPOSITOR" == niri ]]; then
  for cmd in niri niri-session xwayland-satellite quickshell foot fish fastfetch wofi; do check_cmd "$cmd"; done
elif [[ "$COMPOSITOR" == labwc ]]; then
  for cmd in labwc quickshell foot fish fastfetch wofi; do check_cmd "$cmd"; done
else
  warn "could not identify the active THE INDEX compositor"
  for cmd in quickshell foot fish fastfetch wofi; do check_cmd "$cmd"; done
fi

section "SESSION"
check_file /usr/share/wayland-sessions/the-index.desktop "THE INDEX Wayland session registered"
if has systemctl; then
  if systemctl is-enabled --quiet gdm.service 2>/dev/null || systemctl is-enabled --quiet gdm3.service 2>/dev/null; then ok "GDM enabled"; else warn "GDM is not enabled"; fi
else
  warn "systemctl unavailable; GDM state not checked"
fi
if [[ "$COMPOSITOR" == niri ]]; then
  [[ -n "${NIRI_SOCKET:-}" ]] && ok "niri IPC socket exported" || warn "NIRI_SOCKET is not set in this shell"
  if grep -q '^Exec=niri-session$' /usr/share/wayland-sessions/the-index.desktop 2>/dev/null; then ok "THE INDEX session launches niri-session"; else fail "THE INDEX session is not configured for niri-session"; fi
elif [[ "$COMPOSITOR" == labwc ]]; then
  ok "labwc compatibility session detected"
fi

section "INDEX CONFIG"
if [[ "$COMPOSITOR" == niri ]]; then
  check_file "$HOME/.config/niri/config.kdl" "niri configuration"
  check_file "$HOME/.config/niri/index-input.kdl" "niri managed input"
  check_file "$HOME/.config/niri/index-cursor.kdl" "niri managed cursor"
  check_file "$HOME/.config/niri/index-outputs.kdl" "niri managed outputs"
  check_file "$HOME/.config/xdg-desktop-portal/niri-portals.conf" "niri portal routing"
  if has niri && NIRI_CONFIG="$HOME/.config/niri/config.kdl" niri validate >/dev/null 2>&1; then ok "niri configuration parses"; else fail "niri configuration validation failed"; fi
elif [[ "$COMPOSITOR" == labwc ]]; then
  check_file "$HOME/.config/labwc/rc.xml" "labwc configuration"
  check_file "$HOME/.config/labwc/autostart" "labwc autostart"
  check_file "$HOME/.config/labwc/index-display-save" "labwc display layout saver"
  check_file "$HOME/.config/labwc/index-display-restore" "labwc display layout restorer"
fi

check_file "$HOME/.config/quickshell/shell.qml" "Quickshell shell"
check_file "$HOME/.config/quickshell/Bar.qml" "Quickshell top bar"
check_file "$HOME/.config/quickshell/StartMenuState.qml" "launcher IPC router"
check_file "$HOME/.config/quickshell/ClipboardPopup.qml" "Clipboard popup"
check_file "$HOME/.config/quickshell/Notifications.qml" "Notification server UI"
check_file "$HOME/.config/quickshell/NotifHistory.qml" "Notification history"
check_file "$HOME/.config/quickshell/NotificationPrefs.qml" "Notification preferences state"
check_file "$HOME/.config/quickshell/NotificationPanel.qml" "Notification settings panel"
check_file "$HOME/.config/quickshell/BluetoothMenu.qml" "Bluetooth panel"
check_file "$HOME/.config/quickshell/PowerPanel.qml" "Power panel"
check_file "$HOME/.config/quickshell/DisplaysPanel.qml" "Display panel"
check_file "$HOME/.config/quickshell/InputPanel.qml" "Input panel"
check_file "$HOME/.config/quickshell/Prescript.qml" "Prescript widget"
check_file "$HOME/.config/quickshell/PrescriptState.qml" "Shared Prescript state"

for helper in index-session-start index-lock index-logout index-idle index-display-save index-display-restore index-appearance index-audio index-network index-bluetooth index-power index-input index-clipboard index-notifications index-settings; do
  check_file "$HOME/.local/bin/$helper" "$helper"
done

if [[ -f "$HOME/.config/quickshell/shell.qml" ]] && grep -q 'model: Quickshell.screens' "$HOME/.config/quickshell/shell.qml" && grep -q 'screen: modelData' "$HOME/.config/quickshell/shell.qml"; then
  ok "per-monitor shell surfaces enabled"
else
  fail "per-monitor shell surfaces missing"
fi

if [[ -x "$HOME/.local/bin/index-input" && "$COMPOSITOR" != unknown ]]; then
  INPUT_STATE="$(INDEX_INPUT_BACKEND="$COMPOSITOR" "$HOME/.local/bin/index-input" state 2>/dev/null || true)"
  [[ "${INPUT_STATE%%$'\t'*}" == 1 ]] && ok "$COMPOSITOR input backend readable" || fail "$COMPOSITOR input backend unavailable"
fi
if [[ -x "$HOME/.local/bin/index-clipboard" ]]; then
  CLIP_STATE="$("$HOME/.local/bin/index-clipboard" dump 2>/dev/null | head -n1 || true)"
  [[ "$CLIP_STATE" == $'@status\t1\t'* ]] && ok "clipboard backend readable" || fail "clipboard backend unavailable"
fi
if [[ -x "$HOME/.local/bin/index-notifications" ]]; then
  NOTIFY_STATE="$("$HOME/.local/bin/index-notifications" state 2>/dev/null || true)"
  [[ "$NOTIFY_STATE" == $'1\t'* ]] && ok "notification preferences readable" || fail "notification preferences unavailable"
fi

check_file "$HOME/.config/foot/foot.ini" "Foot configuration"
check_file "$HOME/.config/fish/config.fish" "Fish configuration"
check_file "$HOME/.config/wofi/config" "Wofi configuration"

section "THEMING"
check_file "$HOME/.local/share/themes/the-index/gtk-3.0/gtk.css" "Index GTK3 theme"
check_file "$HOME/.local/share/themes/the-index/gtk-4.0/gtk.css" "Index GTK4 theme"
check_file "$HOME/.config/gtk-3.0/settings.ini" "GTK3 settings"
check_file "$HOME/.config/gtk-3.0/gtk.css" "GTK3 user stylesheet"
check_file "$HOME/.config/gtk-4.0/settings.ini" "GTK4 settings"
check_file "$HOME/.config/gtk-4.0/gtk.css" "GTK4 user stylesheet"
if [[ "$COMPOSITOR" == niri ]]; then
  if grep -q 'active-color "#5DADE2"' "$HOME/.config/niri/config.kdl" 2>/dev/null; then ok "niri Index cyan active border"; else fail "niri Index border styling missing"; fi
elif [[ "$COMPOSITOR" == labwc ]]; then
  check_file "$HOME/.local/share/themes/the-index/labwc/themerc" "Index labwc theme"
fi
if [[ -f "$HOME/.config/gtk-3.0/gtk.css" ]] && grep -q '^\.thunar menubar > menuitem' "$HOME/.config/gtk-3.0/gtk.css"; then ok "Thunar GTK polish rules installed"; else fail "Thunar GTK polish rules missing"; fi
if [[ -f /usr/share/icons/Papirus-Dark/index.theme ]]; then ok "Papirus-Dark icon theme"; else fail "Papirus-Dark icon theme missing"; fi
if [[ -d /usr/share/icons/Adwaita/cursors ]]; then ok "Adwaita cursor theme"; else fail "Adwaita cursor theme missing"; fi
if has fc-match && fc-match 'Perfect DOS VGA 437 Universal' 2>/dev/null | grep -qi 'PerfectDOS\|Perfect DOS'; then ok "Perfect DOS VGA Universal font available"; else warn "Perfect DOS VGA Universal font could not be confirmed"; fi

section "DESKTOP SERVICES"
for cmd in nmcli bluetoothctl wpctl wl-copy wl-paste cliphist qalc ffmpeg notify-send playerctl upower brightnessctl wlr-randr; do check_cmd "$cmd"; done
if has systemctl; then
  for svc in NetworkManager bluetooth cups; do
    if systemctl is-enabled --quiet "$svc.service" 2>/dev/null; then ok "$svc enabled"; else warn "$svc not enabled"; fi
  done
  if systemctl is-active --quiet power-profiles-daemon.service 2>/dev/null || systemctl is-active --quiet tuned-ppd.service 2>/dev/null; then
    ok "power profile backend active"
  else
    warn "power profile backend not active"
  fi
fi
if has pgrep && pgrep -x pipewire >/dev/null 2>&1; then ok "PipeWire running"; else warn "PipeWire not detected in current session"; fi
if has pgrep && pgrep -x wireplumber >/dev/null 2>&1; then ok "WirePlumber running"; else warn "WirePlumber not detected in current session"; fi

section "RESULT"
printf '  %s%d passed%s / %s%d warnings%s / %s%d failed%s\n' "$GREEN" "$PASS" "$NC" "$YELLOW" "$WARN" "$NC" "$RED" "$FAIL" "$NC"

if (( FAIL > 0 )); then exit 1; fi
exit 0
