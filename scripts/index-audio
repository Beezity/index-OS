#!/bin/sh
# WILL OF THE CITY :: THE INDEX — PipeWire/WirePlumber audio helper
set -eu

require_wpctl() {
  command -v wpctl >/dev/null 2>&1 || {
    echo "wpctl is required" >&2
    exit 1
  }
}

sanitize_label() {
  tr '\t\r' '  '
}

node_label() {
  target=$1
  wpctl inspect "$target" 2>/dev/null | sed -n \
    -e 's/^[[:space:]]*\*\{0,1\}[[:space:]]*node.description = "\(.*\)"$/\1/p' \
    -e 's/^[[:space:]]*\*\{0,1\}[[:space:]]*node.nick = "\(.*\)"$/\1/p' \
    -e 's/^[[:space:]]*\*\{0,1\}[[:space:]]*node.name = "\(.*\)"$/\1/p' | head -1 | sanitize_label
}

volume_percent() {
  target=$1
  out=$(wpctl get-volume "$target" 2>/dev/null || true)
  value=$(printf '%s\n' "$out" | awk '{for(i=1;i<=NF;i++) if($i ~ /^[0-9]+(\.[0-9]+)?$/){printf "%d", $i*100; exit}}')
  [ -n "$value" ] || value=0
  muted=0
  printf '%s' "$out" | grep -q '\[MUTED\]' && muted=1 || true
  printf '%s|%s' "$value" "$muted"
}

list_section() {
  kind=$1
  case "$kind" in
    output) start='Sinks:' ;;
    input) start='Sources:' ;;
    *) exit 2 ;;
  esac

  wpctl status 2>/dev/null | awk -v start="$start" -v kind="$kind" '
    index($0, start) { inside=1; next }
    inside && kind == "output" && index($0, "Sources:") { exit }
    inside && kind == "input" && (index($0, "Filters:") || index($0, "Streams:") || index($0, "Video")) { exit }
    inside {
      line=$0
      sub(/^[^0-9]*/, "", line)
      if (line ~ /^[0-9]+\./) {
        id=line
        sub(/\..*/, "", id)
        sub(/^[0-9]+\.[[:space:]]*/, "", line)
        sub(/[[:space:]]*\[vol:.*$/, "", line)
        gsub(/[[:space:]]+$/, "", line)
        print id "|" line
      }
    }'
}

choose_default() {
  kind=$1
  case "$kind" in
    output) prompt='audio output' ;;
    input) prompt='audio input' ;;
    *) exit 2 ;;
  esac

  entries=$(list_section "$kind")
  [ -n "$entries" ] || exit 0
  command -v wofi >/dev/null 2>&1 || {
    echo "wofi is required for device selection" >&2
    exit 1
  }

  selected=$(printf '%s\n' "$entries" | awk -F'|' '{print "[" $1 "] " $2}' | wofi --dmenu -p "$prompt" || true)
  [ -n "$selected" ] || exit 0
  id=$(printf '%s\n' "$selected" | sed -n 's/^\[\([0-9][0-9]*\)\].*/\1/p')
  [ -n "$id" ] && wpctl set-default "$id"
}

set_volume() {
  target=$1
  value=${2:-}
  case "$value" in
    ''|*[!0-9]*) echo "volume must be an integer from 0 to 100" >&2; exit 2 ;;
  esac
  [ "$value" -le 100 ] || value=100
  wpctl set-volume -l 1.0 "$target" "$value%"
}

require_wpctl

case "${1:-}" in
  state)
    if ! wpctl status >/dev/null 2>&1; then
      printf '0\t0|0\t0|0\tNO OUTPUT\tNO INPUT\n'
      exit 0
    fi
    ov=$(volume_percent @DEFAULT_AUDIO_SINK@)
    iv=$(volume_percent @DEFAULT_AUDIO_SOURCE@)
    out_name=$(node_label @DEFAULT_AUDIO_SINK@ || true)
    in_name=$(node_label @DEFAULT_AUDIO_SOURCE@ || true)
    [ -n "$out_name" ] || out_name='NO OUTPUT'
    [ -n "$in_name" ] || in_name='NO INPUT'
    printf '1\t%s\t%s\t%s\t%s\n' "$ov" "$iv" "$out_name" "$in_name"
    ;;
  list-outputs) list_section output ;;
  list-inputs) list_section input ;;
  choose-output) choose_default output ;;
  choose-input) choose_default input ;;
  set-output-volume) set_volume @DEFAULT_AUDIO_SINK@ "${2:-}" ;;
  set-input-volume) set_volume @DEFAULT_AUDIO_SOURCE@ "${2:-}" ;;
  toggle-output-mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
  toggle-input-mute) wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ;;
  *)
    echo "usage: index-audio {state|list-outputs|list-inputs|choose-output|choose-input|set-output-volume PCT|set-input-volume PCT|toggle-output-mute|toggle-input-mute}" >&2
    exit 2
    ;;
esac
