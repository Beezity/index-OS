#!/bin/sh
set -eu

export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=labwc
export XDG_CURRENT_DESKTOP=labwc
export XDG_MENU_PREFIX=labwc-
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM=wayland

# greetd normally starts the selected command as the authenticated user. Give
# desktop services a fresh user D-Bus session and let labwc own the session.
exec dbus-run-session labwc
