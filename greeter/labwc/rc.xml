<?xml version="1.0"?>
<labwc_config xmlns="http://openbox.org/3.4/rc">
  <core>
    <decoration>server</decoration>
    <gap>0</gap>
  </core>
  <theme>
    <name>the-index</name>
  </theme>
  <keyboard>
    <!-- Keep VT switching available as the recovery path. No application,
         shell, logout or compositor-control bindings are exposed here. -->
    <keybind key="C-A-F2"><action name="VirtualTerminal"><to>2</to></action></keybind>
    <keybind key="C-A-F3"><action name="VirtualTerminal"><to>3</to></action></keybind>
    <keybind key="C-A-F4"><action name="VirtualTerminal"><to>4</to></action></keybind>
    <keybind key="C-A-F5"><action name="VirtualTerminal"><to>5</to></action></keybind>
    <keybind key="C-A-F6"><action name="VirtualTerminal"><to>6</to></action></keybind>
  </keyboard>
</labwc_config>
