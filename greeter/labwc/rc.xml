<?xml version="1.0"?>
<labwc_config xmlns="http://openbox.org/3.4/rc">
  <core>
    <decoration>server</decoration>
    <gap>0</gap>
  </core>
  <theme>
    <name>the-index</name>
  </theme>
  <!-- Intentionally no keyboard bindings. Linux VT switching is handled by
       the kernel/logind path, so Ctrl+Alt+F2..F6 remains available without a
       compositor action. Keeping the greeter config empty also prevents
       terminals, launchers, menus, or compositor controls at the login screen. -->
  <keyboard />
</labwc_config>
