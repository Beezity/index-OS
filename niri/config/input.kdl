// WILL OF THE CITY :: THE INDEX — managed input defaults
// index-input rewrites this section when Settings changes pointer options.
input {
    keyboard {
        repeat-rate 30
        repeat-delay 400
        track-layout "global"
    }

    mouse {
        accel-speed 0.0
        accel-profile "adaptive"
    }

    touchpad {
        tap
        dwt
        drag true
        accel-speed 0.0
        accel-profile "adaptive"
        scroll-factor 1.0
    }
}
