// WILL OF THE CITY :: THE INDEX — niri backend
// Static compositor policy lives here. Settings-managed input/output/cursor
// state is split into included files so helpers can update it atomically.

include "input.kdl"
include "outputs.kdl"
include "cursor.kdl"

environment {
    QT_QPA_PLATFORMTHEME "qt6ct"
    GTK_THEME "the-index"
    MOZ_ENABLE_WAYLAND "1"
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_DESKTOP "niri"
}

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/screenshot_%Y-%m-%d_%H-%M-%S.png"
spawn-sh-at-startup "~/.config/niri/index-autostart"

hotkey-overlay {
    skip-at-startup
}

layout {
    gaps 6
    center-focused-column "on-overflow"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#5DADE2"
        inactive-color "#3A7CA5"
        urgent-color "#FF6B6B"
    }

    border { off; }
}

window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
}

binds {
    Mod+Return { spawn "foot"; }
    Mod+D { spawn "wofi" "--show" "drun"; }
    Mod+Space { spawn-sh "qs ipc call startmenu toggle || quickshell ipc call startmenu toggle"; }
    Mod+Q repeat=false { close-window; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+O repeat=false { toggle-overview; }

    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-up; }
    Mod+Down { focus-window-down; }
    Mod+Ctrl+Left { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up { move-window-up; }
    Mod+Ctrl+Down { move-window-down; }

    Mod+Shift+Left { focus-monitor-left; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+Up { focus-monitor-up; }
    Mod+Shift+Down { focus-monitor-down; }
    Mod+Ctrl+Shift+Left { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+Right { move-column-to-monitor-right; }
    Mod+Ctrl+Shift+Up { move-column-to-monitor-up; }
    Mod+Ctrl+Shift+Down { move-column-to-monitor-down; }

    Mod+Page_Up { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Ctrl+Page_Up { move-column-to-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }

    Mod+R { switch-preset-column-width; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+V { toggle-window-floating; }
    Mod+W { toggle-column-tabbed-display; }

    Mod+L allow-inhibiting=false { spawn "index-lock"; }
    Mod+P { spawn-sh "qs ipc call prescript toggle || quickshell ipc call prescript toggle"; }
    Mod+V { spawn-sh "qs ipc call clipboard toggle || quickshell ipc call clipboard toggle"; }

    Mod+Shift+S { screenshot; }
    Print { screenshot-screen; }
    Shift+Print { screenshot write-to-disk=false; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "5%-"; }

    Mod+Shift+E { quit; }
}

// Advanced Niri-specific tweaks belong here rather than being recreated in
// Settings. Because this include comes last, it can intentionally override
// THE INDEX defaults without being overwritten by normal updates.
include optional=true "custom.kdl"
