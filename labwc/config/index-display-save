#!/bin/sh
# WILL OF THE CITY :: THE INDEX — snapshot current outputs so they persist
set -eu

CFG="${XDG_CONFIG_HOME:-$HOME/.config}/labwc"
STATE="$CFG/display.json"
mkdir -p "$CFG"
command -v wlr-randr >/dev/null 2>&1 || exit 1
command -v python3 >/dev/null 2>&1 || exit 1

TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT HUP INT TERM
wlr-randr > "$TMP"

python3 - "$TMP" "$STATE" <<'PY'
import json
import os
import re
import sys

source, destination = sys.argv[1:3]
outputs = []
current = None
reading_modes = False

header_re = re.compile(r'^(\S+)\s+"(.*)"$')
mode_re = re.compile(r'^(\d+)x(\d+)\s+px(?:,\s*([0-9.]+)\s+Hz)?(?:\s+\(([^)]*)\))?$')

with open(source, encoding="utf-8", errors="replace") as handle:
    for raw in handle:
        line = raw.rstrip("\n")
        if line and not line[0].isspace():
            match = header_re.match(line)
            if match:
                current = {
                    "name": match.group(1),
                    "description": match.group(2),
                    "enabled": False,
                    "modes": [],
                    "position": {"x": 0, "y": 0},
                    "transform": "normal",
                    "scale": 1.0,
                }
                outputs.append(current)
                reading_modes = False
            continue

        if current is None:
            continue
        text = line.strip()
        if text.startswith("Enabled:"):
            current["enabled"] = text.split(":", 1)[1].strip() == "yes"
            reading_modes = False
        elif text == "Modes:":
            reading_modes = True
        elif reading_modes:
            match = mode_re.match(text)
            if match:
                flags = match.group(4) or ""
                current["modes"].append({
                    "width": int(match.group(1)),
                    "height": int(match.group(2)),
                    "refresh": float(match.group(3) or 0),
                    "preferred": "preferred" in flags,
                    "current": "current" in flags,
                })
                continue
            reading_modes = False

        if text.startswith("Position:"):
            value = text.split(":", 1)[1].strip().split(",", 1)
            if len(value) == 2:
                current["position"] = {"x": int(value[0]), "y": int(value[1])}
        elif text.startswith("Transform:"):
            current["transform"] = text.split(":", 1)[1].strip() or "normal"
        elif text.startswith("Scale:"):
            try:
                current["scale"] = float(text.split(":", 1)[1].strip())
            except ValueError:
                pass

if not outputs:
    raise SystemExit("no outputs returned by wlr-randr")

tmp = destination + ".tmp"
with open(tmp, "w", encoding="utf-8") as handle:
    json.dump(outputs, handle, indent=2)
    handle.write("\n")
os.chmod(tmp, 0o600)
os.replace(tmp, destination)
PY

printf '%s\n' "saved"
