#!/bin/sh
# WILL OF THE CITY :: THE INDEX — idle/lock policy
set -u

CONF="$HOME/.config/labwc/index.conf"
LOCKER="$HOME/.config/labwc/index-lock"
SEC=600

if [ -f "$CONF" ]; then
  value="$(sed -n 's/^SCREEN_OFF_SEC=\([0-9][0-9]*\)$/\1/p' "$CONF" | tail -n1)"
  [ -n "$value" ] && SEC="$value"
fi

pkill -x swayidle 2>/dev/null || true
sleep 0.2

if [ "$SEC" -gt 0 ] 2>/dev/null; then
  OFF_SEC=$((SEC + 5))
  exec swayidle -w \
    timeout "$SEC"     "$LOCKER" \
    timeout "$OFF_SEC" 'wlopm --off \*' \
    resume              'wlopm --on \*' \
    before-sleep        "$LOCKER" \
    lock                "$LOCKER"
else
  exec swayidle -w \
    before-sleep "$LOCKER" \
    lock         "$LOCKER"
fi
