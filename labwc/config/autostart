#!/bin/sh
# WILL OF THE CITY :: THE INDEX — labwc autostart

# Export the Wayland session to D-Bus/systemd so portals and desktop services
# launched on demand inherit the correct compositor environment.
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
  dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE >/dev/null 2>&1 || true
fi

# Desktop wallpaper. The appearance helper owns the persisted selection;
# fall back to the bundled Index wallpaper on a fresh install.
if [ -x "$HOME/.local/bin/index-appearance" ] && [ -f "$HOME/.config/the-index/appearance.conf" ]; then
  "$HOME/.local/bin/index-appearance" apply >/dev/null 2>&1 &
else
  swaybg -i "$HOME/.config/labwc/wall.png" -m fill &
fi

# VMware's SVGA3D + Qt Quick Wayland/EGL path can create an EGL surface and
# then fail eglSwapBuffers with EGL_BAD_SURFACE/protocol errors. The software
# Qt Quick backend is stable there. Keep accelerated rendering everywhere else.
INDEX_QS_ENV=""
if [ -r /sys/class/dmi/id/sys_vendor ] && grep -qi 'vmware' /sys/class/dmi/id/sys_vendor; then
  INDEX_QS_ENV="QT_QUICK_BACKEND=software"
elif command -v systemd-detect-virt >/dev/null 2>&1 && [ "$(systemd-detect-virt 2>/dev/null || true)" = "vmware" ]; then
  INDEX_QS_ENV="QT_QUICK_BACKEND=software"
fi

if [ -n "$INDEX_QS_ENV" ]; then
  env $INDEX_QS_ENV quickshell -p "$HOME/.config/quickshell/shell.qml" &
else
  quickshell -p "$HOME/.config/quickshell/shell.qml" &
fi

# Polkit agent for privileged GUI operations.
for p in /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 \
         /usr/libexec/polkit-gnome-authentication-agent-1; do
  if [ -x "$p" ]; then
    "$p" &
    break
  fi
done

# Clipboard history (Super+V).
if command -v wl-paste >/dev/null 2>&1 && command -v cliphist >/dev/null 2>&1; then
  wl-paste --type text --watch cliphist store &
  wl-paste --type image --watch cliphist store &
fi

# Removable-media automounting.
command -v udiskie >/dev/null 2>&1 && udiskie --no-notify &

# Restore persisted brightness/display state. Labwc input state is stored
# directly in rc.xml and therefore does not need a separate session restore.
[ -f "$HOME/.config/labwc/index.conf" ] && . "$HOME/.config/labwc/index.conf"
if [ -n "${BRIGHTNESS:-}" ] && command -v brightnessctl >/dev/null 2>&1; then
  brightnessctl set "$BRIGHTNESS%" >/dev/null 2>&1 || true
fi

[ -x "$HOME/.config/labwc/index-idle" ] && "$HOME/.config/labwc/index-idle" &
[ -x "$HOME/.config/labwc/index-display-restore" ] && "$HOME/.config/labwc/index-display-restore" &

# XDG autostart entries. dex is installed by install.sh and correctly handles
# Desktop Entry quoting/field codes, so avoid hand-parsing Exec= lines.
if command -v dex >/dev/null 2>&1; then
  dex -a -e labwc >/dev/null 2>&1 &
fi

# Fcitx5 used to be started here for the bar's input-layout indicator. The
# indicator is gone, so do not keep an otherwise idle input-method daemon in
# every Index session. Users who need an IME can enable fcitx5 through their
# normal XDG autostart configuration.
