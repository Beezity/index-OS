#!/bin/sh
# WILL OF THE CITY :: THE INDEX — clipboard popup launcher with Wofi fallback

if command -v qs >/dev/null 2>&1 && qs ipc call clipboard toggle >/dev/null 2>&1; then
  exit 0
fi
if command -v quickshell >/dev/null 2>&1 && quickshell ipc call clipboard toggle >/dev/null 2>&1; then
  exit 0
fi

# Keep clipboard history usable if Quickshell is unavailable or still starting.
command -v cliphist >/dev/null 2>&1 || exit 0
command -v wofi >/dev/null 2>&1 || exit 0
command -v wl-copy >/dev/null 2>&1 || exit 0

CLEAR='>_ CLEAR HISTORY _<'
pick=$( { printf '%s\n' "$CLEAR"; cliphist list; } | wofi --dmenu -p clipboard )
[ -n "$pick" ] || exit 0

if [ "$pick" = "$CLEAR" ]; then
  if [ -x "$HOME/.local/bin/index-clipboard" ]; then
    "$HOME/.local/bin/index-clipboard" clear
  else
    cliphist wipe
  fi
  exit 0
fi

id=${pick%%	*}
case "$id" in
  ''|*[!0-9]*) printf '%s' "$pick" | cliphist decode | wl-copy ;;
  *)
    if [ -x "$HOME/.local/bin/index-clipboard" ]; then
      "$HOME/.local/bin/index-clipboard" select "$id"
    else
      printf '%s' "$pick" | cliphist decode | wl-copy
    fi
    ;;
esac
