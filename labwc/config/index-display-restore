#!/bin/sh
# WILL OF THE CITY :: THE INDEX — reapply the saved output layout at login
set -eu

J="${XDG_CONFIG_HOME:-$HOME/.config}/labwc/display.json"
[ -f "$J" ] || exit 0
command -v wlr-randr >/dev/null 2>&1 || exit 0
command -v python3 >/dev/null 2>&1 || exit 0

sleep 1
python3 - "$J" <<'PY'
import json
import subprocess
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as handle:
        outputs = json.load(handle)
except Exception:
    raise SystemExit(0)

args = ["wlr-randr"]
for output in outputs:
    name = output.get("name")
    if not name:
        continue
    args += ["--output", name]
    if not output.get("enabled"):
        args += ["--off"]
        continue

    args += ["--on"]
    modes = output.get("modes") or []
    mode = next((m for m in modes if m.get("current")), None)
    if mode is None:
        mode = next((m for m in modes if m.get("preferred")), None)
    if mode is not None:
        value = f"{int(mode['width'])}x{int(mode['height'])}"
        refresh = float(mode.get("refresh") or 0)
        if refresh > 0:
            value += f"@{refresh:.3f}Hz"
        args += ["--mode", value]
    else:
        args += ["--preferred"]

    position = output.get("position") or {}
    try:
        x = int(position.get("x", 0))
        y = int(position.get("y", 0))
        args += ["--pos", f"{x},{y}"]
    except (TypeError, ValueError):
        pass

    try:
        scale = float(output.get("scale", 1.0))
        if scale > 0:
            args += ["--scale", f"{scale:.2f}"]
    except (TypeError, ValueError):
        pass

    transform = output.get("transform") or "normal"
    if transform in {"normal", "90", "180", "270", "flipped", "flipped-90", "flipped-180", "flipped-270"}:
        args += ["--transform", transform]

if len(args) > 1:
    subprocess.run(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
PY
